<%- include('../partials/layout', { body: `
<div class="admin-layout">
  <aside class="admin-sidebar">
    <h3>Menu Admin</h3>
    <a href="/admin" class="active">📊 Dashboard</a>
    <a href="/admin/orders">🛒 Kelola Order ${stats.pendingOrders > 0 ? '<span style="background: var(--warning); color: #000; padding: 2px 6px; border-radius: 10px; font-size: 0.7rem; font-weight: 700;">' + stats.pendingOrders + '</span>' : ''}</a>
    <a href="/admin/games">🎮 Kelola Game</a>
    <a href="/admin/products">📦 Kelola Produk</a>
    <a href="/admin/listings">🛍️ Listing Member</a>
    <a href="/admin/users">👥 Kelola User</a>
    <a href="/" target="_blank" style="margin-top: auto;">🌐 Lihat Web</a>
  </aside>
  
  <div class="admin-content">
    <h1>Dashboard Admin</h1>
    
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon">💰</div>
        <div class="stat-value">Rp ${parseInt(stats.totalRevenue).toLocaleString('id-ID')}</div>
        <div class="stat-label">Total Pendapatan</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">🛒</div>
        <div class="stat-value">${stats.totalOrders}</div>
        <div class="stat-label">Total Pesanan</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">🎮</div>
        <div class="stat-value">${stats.totalGames}</div>
        <div class="stat-label">Game Aktif</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">👥</div>
        <div class="stat-value">${stats.totalUsers}</div>
        <div class="stat-label">Total Pengguna</div>
      </div>
    </div>

    <!-- Charts Row -->
    <div class="d-flex gap-3" style="flex-wrap: wrap; margin-bottom: 24px;">
      <div class="card" style="flex: 1; min-width: 300px;">
        <div class="card-header"><h3>📊 Status Pesanan</h3></div>
        <div style="height: 250px; display: flex; align-items: flex-end; gap: 8px; padding: 20px 0;">
          ${statusChart.labels.map((l, i) => {
            const max = Math.max(...statusChart.data, 1);
            const pct = (statusChart.data[i] / max * 100);
            const colors = { pending: '#f59e0b', processing: '#6366f1', success: '#10b981', failed: '#ef4444', cancelled: '#64748b' };
            return '<div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px;">' +
              '<div style="font-weight: 700; font-size: 0.85rem;">' + statusChart.data[i] + '</div>' +
              '<div style="width: 100%; max-width: 60px; height: 180px; background: var(--bg-input); border-radius: 8px; position: relative; overflow: hidden;">' +
              '<div style="position: absolute; bottom: 0; width: 100%; height: ' + pct + '%; background: ' + (colors[l] || '#6366f1') + '; border-radius: 8px; transition: height 0.5s ease;"></div></div>' +
              '<div style="font-size: 0.65rem; color: var(--text-muted); text-transform: capitalize;">' + l + '</div></div>';
          }).join('')}
        </div>
      </div>
      
      <div class="card" style="flex: 2; min-width: 400px;">
        <div class="card-header"><h3>📈 7 Hari Terakhir</h3></div>
        <div style="height: 250px; padding: 20px 0; position: relative;">
          <canvas id="revenueChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Top Products -->
    ${topProducts && topProducts.length > 0 ? `
    <div class="card mb-4">
      <div class="card-header"><h3>🏆 Produk Terlaris</h3></div>
      <div class="table-responsive">
        <table class="table">
          <thead><tr><th>#</th><th>Produk</th><th>Game</th><th>Terjual</th><th>Pendapatan</th></tr></thead>
          <tbody>
            ${topProducts.map((tp, i) => '<tr><td>' + (i+1) + '</td><td>' + tp.name + '</td><td>' + tp.game_name + '</td><td><strong>' + tp.total_sold + '</strong></td><td class="text-success">Rp ' + parseInt(tp.total_revenue).toLocaleString('id-ID') + '</td></tr>').join('')}
          </tbody>
        </table>
      </div>
    </div>
    ` : ''}
    
    <div class="card">
      <div class="card-header">
        <h3>Pesanan Terbaru</h3>
        <a href="/admin/orders" class="btn btn-sm btn-outline">Lihat Semua</a>
      </div>
      
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>ID</th>
              <th>User</th>
              <th>Game/Produk</th>
              <th>Target</th>
              <th>Total</th>
              <th>Status</th>
              <th>Tanggal</th>
            </tr>
          </thead>
          <tbody>
            ${recentOrders.map(o => `
              <tr>
                <td><strong>${o.order_id}</strong></td>
                <td>${o.username || 'Tamu'}</td>
                <td>
                  <div style="font-size: 0.8rem; color: var(--text-muted);">${o.game_name}</div>
                  <div>${o.product_name}</div>
                </td>
                <td>${o.game_user_id} ${o.game_server ? '(' + o.game_server + ')' : ''}</td>
                <td>Rp ${parseInt(o.total_price).toLocaleString('id-ID')}</td>
                <td><span class="status-badge status-${o.status}">${o.status}</span></td>
                <td class="text-muted" style="font-size: 0.8rem;">${new Date(o.created_at).toLocaleString('id-ID')}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  const ctx = document.getElementById('revenueChart').getContext('2d');
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: ${JSON.stringify(dayChart.labels)},
      datasets: [
        {
          label: 'Pesanan',
          data: ${JSON.stringify(dayChart.orders)},
          borderColor: '#6366f1',
          backgroundColor: 'rgba(99,102,241,0.1)',
          fill: true,
          tension: 0.4,
          yAxisID: 'y'
        },
        {
          label: 'Revenue (Rp)',
          data: ${JSON.stringify(dayChart.revenue)},
          borderColor: '#10b981',
          backgroundColor: 'rgba(16,185,129,0.1)',
          fill: true,
          tension: 0.4,
          yAxisID: 'y1'
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { intersect: false, mode: 'index' },
      plugins: {
        legend: { labels: { color: '#94a3b8' } }
      },
      scales: {
        x: { ticks: { color: '#64748b' }, grid: { color: 'rgba(255,255,255,0.03)' } },
        y: { ticks: { color: '#64748b', stepSize: 1 }, grid: { color: 'rgba(255,255,255,0.03)' } },
        y1: { position: 'right', ticks: { color: '#10b981', callback: function(v) { return 'Rp' + v.toLocaleString('id-ID'); } }, grid: { display: false } }
      }
    }
  });
</script>
` }) %>