<%- include('partials/header') %>
<div class="container" style="padding: 40px 0;">
  <div class="section-header">
    <div class="section-header-left">
      <h2>❤️ Wishlist Saya</h2>
      <p class="subtitle">Listing favorit yang kamu simpan</p>
    </div>
    <div class="section-header-right">
      <a href="/seller/marketplace" class="btn btn-outline btn-sm">🛍️ Jelajahi Marketplace</a>
    </div>
  </div>

  <% if (items && items.length > 0) { %>
    <div class="d-flex flex-wrap gap-3">
      <% items.forEach(function(l) { %>
        <div class="card" style="flex: 1; min-width: 300px; max-width: 400px; display: flex; flex-direction: column; position: relative;">
          <% if (l.featured) { %><div style="position: absolute; top: -1px; left: -1px; background: var(--gradient-accent); color: white; padding: 4px 14px; border-radius: 0 0 var(--radius-sm) 0; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.5px;">⭐ FEATURED</div><% } %>
          <div class="d-flex align-center gap-3 mb-3">
            <div style="width: 56px; height: 56px; background: var(--bg-input); border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; border: 1px solid var(--border);">
              <%= l.category === 'akun' ? '💎' : l.category === 'joki' ? '🏆' : '🔄' %>
            </div>
            <div>
              <h4 style="font-weight: 700; font-size: 1rem;"><%= l.title.length > 50 ? l.title.substring(0,50)+'...' : l.title %></h4>
              <div class="d-flex gap-2 align-center">
                <span class="status-badge" style="background: var(--accent-soft); color: var(--accent); border: 1px solid var(--border); text-transform: capitalize; font-size: 0.65rem;"><%= l.game_name %></span>
                <span class="status-badge" style="background: rgba(16,185,129,0.08); color: var(--text-muted); border: 1px solid var(--border); font-size: 0.65rem;"><%= l.category %></span>
              </div>
            </div>
          </div>
          <div style="flex: 1; margin-bottom: 12px;">
            <p class="text-muted" style="font-size: 0.85rem; line-height: 1.6;"><%= (l.description || 'Tidak ada deskripsi.').length > 100 ? (l.description || '').substring(0,100)+'...' : (l.description || 'Tidak ada deskripsi.') %></p>
          </div>
          <div class="d-flex align-center justify-between" style="border-top: 1px solid var(--border); padding-top: 12px;">
            <div>
              <div class="text-muted" style="font-size: 0.7rem;">Harga</div>
              <div style="font-size: 1.2rem; font-weight: 800; color: var(--success);">
                Rp <%= parseInt(l.price).toLocaleString('id-ID') %>
              </div>
            </div>
            <div class="d-flex gap-1">
              <a href="/seller/listing/<%= l.listing_id %>" class="btn btn-sm btn-outline">Detail</a>
              <form action="/wishlist/remove/<%= l.listing_id %>" method="POST" style="display:inline;" onsubmit="return confirm('Hapus dari wishlist?')">
                <button type="submit" class="btn btn-sm btn-danger">❤️ Hapus</button>
              </form>
            </div>
          </div>
          <div class="text-muted mt-1" style="font-size: 0.7rem;">👤 <%= l.username %> · 👁 <%= l.views %> · ⭐ <%= l.listing_status %></div>
        </div>
      <% }) %>
    </div>
    
    <!-- Pagination -->
    <% if (pagination && pagination.totalPages > 1) { %>
      <div class="pagination mt-4">
        <% if (pagination.page > 1) { %>
          <a href="?page=<%= pagination.page - 1 %>" class="btn btn-outline btn-sm">← Sebelumnya</a>
        <% } %>
        <% for (let p = 1; p <= pagination.totalPages; p++) { %>
          <a href="?page=<%= p %>" class="btn <%= p === pagination.page ? 'btn-primary' : 'btn-outline' %> btn-sm"><%= p %></a>
        <% } %>
        <% if (pagination.page < pagination.totalPages) { %>
          <a href="?page=<%= pagination.page + 1 %>" class="btn btn-outline btn-sm">Selanjutnya →</a>
        <% } %>
        <span class="text-muted" style="font-size: 0.85rem; margin-left: 12px;">Total <%= pagination.total %> item</span>
      </div>
    <% } %>
  <% } else { %>
    <div class="card text-center" style="padding: 60px;">
      <div style="font-size: 4rem; margin-bottom: 16px;">💔</div>
      <h3 style="color: var(--text-secondary);">Wishlist masih kosong</h3>
      <p class="text-muted mt-2">Temukan listing menarik dan simpan ke wishlist!</p>
      <a href="/seller/marketplace" class="btn btn-primary btn-lg mt-3">🛍️ Jelajahi Marketplace</a>
    </div>
  <% } %>
</div>
<%- include('partials/footer') %>
