<%- include('../partials/header') %>
<div class="container" style="max-width: 500px; padding: 60px 0;">
  <div class="card" style="padding: 40px;">
    <% if (step === 'email') { %>
      <div class="text-center mb-4">
        <div style="font-size: 3rem; margin-bottom: 12px;">🔒</div>
        <h2>Lupa Password</h2>
        <p class="text-muted mt-1">Masukkan email terdaftar untuk mendapatkan link reset password</p>
      </div>
      <form action="/auth/forgot" method="POST">
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" class="form-control" placeholder="email@contoh.com" required>
        </div>
        <button type="submit" class="btn btn-primary btn-block btn-lg mt-3">📧 Kirim Link Reset</button>
        <div class="text-center mt-3">
          <a href="/auth/login" class="text-accent">← Kembali ke Login</a>
        </div>
      </form>
    <% } else if (step === 'reset') { %>
      <div class="text-center mb-4">
        <div style="font-size: 3rem; margin-bottom: 12px;">🔑</div>
        <h2>Reset Password</h2>
        <p class="text-muted mt-1">Buat password baru untuk akunmu</p>
      </div>
      <form action="/auth/reset/<%= token %>" method="POST">
        <div class="form-group">
          <label>Password Baru</label>
          <input type="password" name="password" class="form-control" placeholder="Minimal 6 karakter" minlength="6" required>
        </div>
        <div class="form-group">
          <label>Konfirmasi Password Baru</label>
          <input type="password" name="confirm_password" class="form-control" placeholder="Ulangi password" minlength="6" required>
        </div>
        <button type="submit" class="btn btn-primary btn-block btn-lg mt-3">🔄 Reset Password</button>
        <div class="text-center mt-3">
          <a href="/auth/login" class="text-accent">← Kembali ke Login</a>
        </div>
      </form>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
